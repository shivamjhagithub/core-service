# Local defaults — works after clone if MySQL (root/root) and Redis are running.
# Change DATABASE_PASSWORD / REDIS_* if your laptop uses different credentials.

SERVER_PORT=8082

MYSQL_DATABASE=collegeerp
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
DATABASE_URL=jdbc:mysql://localhost:3306/collegeerp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

JWT_SECRET=local-dev-only-college-erp-jwt-secret-key-change-in-prod
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

BOOTSTRAP_ADMIN_USER_ID=MainAdmin001
BOOTSTRAP_ADMIN_EMAIL=admin@college-erp.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=26214400

PUSH_ENABLED=false
PUSH_PROVIDER=noop
MEETING_PROVIDER=internal-webrtc

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=300
RATE_LIMIT_AUTH_RPM=20
