# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
SERVER_PORT=8082

# --- MySQL ---
MYSQL_DATABASE=collegeerp
MYSQL_ROOT_PASSWORD=root
# Change if something already listens on 3306.
MYSQL_PORT=3306
# Used when running the app outside Docker:
DATABASE_URL=jdbc:mysql://localhost:3306/collegeerp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# --- Security ---
# REQUIRED. HMAC-SHA signing key, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Platform operator created on an empty database ---
BOOTSTRAP_ADMIN_USER_ID=MainAdmin001
BOOTSTRAP_ADMIN_EMAIL=admin@college-erp.local
# Leave blank to have a random password generated and logged once at startup.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka (optional: asynchronous fan-out only) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=26214400

# --- Push notifications (provider is opt-in) ---
PUSH_ENABLED=false
PUSH_PROVIDER=noop

# --- Video conference provider ---
MEETING_PROVIDER=internal-webrtc

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=300
RATE_LIMIT_AUTH_RPM=20
